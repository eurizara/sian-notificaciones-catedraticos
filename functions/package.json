{
  "name": "sian-functions",
  "version": "0.1.0",
  "private": true,
  "description": "SIAN — Cloud Functions. Dominio, aplicación, infraestructura y disparadores.",
  "license": "MIT",
  "main": "lib/src/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "lint": "eslint src test",
    "lint:fix": "eslint src test --fix",
    "test": "jest --config jest.config.js",
    "test:cobertura": "jest --config jest.config.js --coverage",
    "test:rules": "jest --config jest.rules.config.js --runInBand",
    "verificar": "npm run lint && npm run build && npm run test:cobertura",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions"
  },
  "dependencies": {
    "firebase-admin": "^14.2.0",
    "firebase-functions": "^7.3.2",
    "luxon": "^3.7.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@types/jest": "^30.0.0",
    "@types/luxon": "^3.7.3",
    "@types/node": "^20.19.43",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^9.39.5",
    "firebase": "^12.17.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.12",
    "typescript": "^5.9.3"
  }
}
