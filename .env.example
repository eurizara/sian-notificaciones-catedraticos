# SIAN — plantilla de configuración local
#
# Copia este archivo como `.env.local` y rellena los valores de TU proyecto.
# `.env.local` está en .gitignore y jamás debe versionarse (RES-10, RNF-10).
#
#   cp .env.example .env.local

# Clave pública VAPID para Web Push.
# Consola de Firebase → Configuración del proyecto → Cloud Messaging →
# Web configuration → Generate key pair. Es pública por diseño, pero se trata
# como configuración por ambiente, no como constante del código.
FIREBASE_VAPID_KEY=

# Identificador del proyecto de Firebase al que apunta esta copia local.
# Valores esperados: sian-dev | sian-qa | sian-prod
FIREBASE_PROJECT_ID=

# Zona horaria institucional (RF-ADM-01, RN-05).
# Toda fecha se almacena en UTC y se presenta en esta zona.
ZONA_HORARIA=America/Guatemala

# Apuntar la aplicación a los emuladores locales en lugar de la nube.
# true durante el desarrollo diario (documento 06, etapa D).
USE_EMULATOR=true

# Identificador del remitente de Cloud Messaging.
# Misma pantalla que la clave VAPID. Cambia con cada proyecto.
FIREBASE_MESSAGING_SENDER_ID=

# Identificadores de la app web de Firebase. Son públicos por diseño: viajan al
# navegador dentro del paquete compilado. Se obtienen con:
#   firebase apps:sdkconfig WEB <appId> --project <proyecto>
# y alimentan `scripts/generar-firebase-options.sh`.
FIREBASE_API_KEY=
FIREBASE_APP_ID=
FIREBASE_STORAGE_BUCKET=

# Dominio de autenticación. OJO: NO es el que da la consola por omisión.
#
# La consola propone `<proyecto>.firebaseapp.com`, pero el sitio se sirve desde
# `<proyecto>.web.app`. Con dos dominios distintos, todo el intercambio con
# Google pasa por un origen ajeno al de la aplicación, y Safari —que reparte el
# almacenamiento por origen— lo bloquea la primera vez: el resultado es un
# «400. That's an error» de accounts.google.com en el primer intento, y un
# segundo intento que sí funciona porque para entonces Safari ya considera
# conocido ese origen.
#
# Firebase Hosting sirve el manejador `/__/auth/` en TODOS los dominios del
# proyecto, así que basta apuntar aquí al mismo desde el que se sirve el sitio
# para que no haya ningún tercero en el flujo.
FIREBASE_AUTH_DOMAIN=
